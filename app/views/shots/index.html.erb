<% content_for(:html_title) { "Visualizer | Your Shots" } %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= render "shared/premium_banner", count: @premium_count %>
<%= render "shared/migration_banner" %>
<%= render "shared/pull_refresh" %>
<div class="mx-auto flex max-w-7xl flex-col sm:px-6 lg:px-8" data-controller="panel upload-drop" data-upload-drop-upload-outlet="#shot-upload-form">
  <%= render "upload_overlay" %>
  <%= render "index_header" %>
  <%= render "upload_form", show_form: @shots.none? %>
  <% if @shots.any? %>
    <%= render "filters" %>
    <div data-controller="modal shot-compare">
      <%= render "shared/modal" %>
      <%= render "comparison_banner" %>
      <div id="shots" class="mt-6 flex flex-col divide-y divide-neutral-200 border-y border-neutral-200 sm:gap-y-4 sm:divide-none sm:border-none dark:divide-neutral-700 dark:border-neutral-700" data-controller="check-images">
        <%= render @shots, selected_tag_slugs: @tag_slugs %>
      </div>
    </div>
    <%= render partial: "shared/cursor_loader", locals: { cursor: @cursor, path: shots_path(params.permit(*Filterable::FILTERS.keys, :min_enjoyment, :max_enjoyment, :coffee_bag, :tags, :start_date, :all_notes).reject { |_, v| v.blank? }.merge(@cursor || {}).merge(format: :turbo_stream)) } %>
  <% else %>
    <div class="my-8 px-6 text-center text-neutral-500 sm:px-8">
      <% if @premium_count.to_i > 0 %>
        Consider <%= link_to("upgrading", premium_index_path, class: "standard-link text-terracotta-600") %> to see your old shots.
      <% else %>
        No shots yet 😢
      <% end %>
    </div>
  <% end %>
</div>
<%= turbo_stream_from Current.user, :shots, id: "shots_live_stream" %>
