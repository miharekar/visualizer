<div class="flex flex-wrap items-center gap-1">
  <% shot.tags.sort_by(&:name).each do |tag| %>
    <% tag_slugs = (selected_tag_slugs + [tag.slug]).uniq.join(",") %>
    <%= link_to shots_path(params.permit(*Filterable::FILTERS.keys, :min_enjoyment, :max_enjoyment, :coffee_bag, :start_date, :all_notes).reject { |_, v| v.blank? }.merge(tags: tag_slugs)), class: "relative z-10 pointer-events-auto" do %>
      <span class="bg-oxford-blue-50 text-oxford-blue-600 group dark:bg-oxford-blue-400/5 dark:text-oxford-blue-300 dark:ring-oxford-blue-400/10 inline-flex items-center rounded-md px-2 py-1 text-xs font-medium hover:bg-neutral-200/75 dark:ring-1 dark:ring-inset dark:hover:bg-neutral-700/75">
        <% if truncate && tag.name.length > 15 %>
          <%= tag.name.truncate(15, omission: "…") %>
        <% else %>
          <%= tag.name %>
        <% end %>
      </span>
    <% end %>
  <% end %>
</div>
