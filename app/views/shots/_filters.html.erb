<div class="my-4 hidden px-4 sm:my-0 sm:block sm:px-0" data-panel-target="instantFilters">
  <%= form_with(url: search_shots_path, data: {controller: "search", search_target: "form"}) do |f| %>
    <%= f.hidden_field :fresh_search, value: 1 %>
    <%= f.hidden_field :coffee_bag, value: params[:coffee_bag] %>
    <%= f.hidden_field :tags, value: params[:tags] %>
    <div class="grid grid-cols-12 gap-3">
      <div class="col-span-12 md:col-span-6">
        <%= f.label :q, "Search", class: "standard-label" %>
        <%= f.search_field :q, value: params[:q], class: "mt-1 standard-input", placeholder: "Search coffee, notes, tags...", data: {action: "search#submit"} %>
      </div>
      <div class="col-span-6 md:col-span-3">
        <%= f.label :start_date, "Date", class: "standard-label" %>
        <%= f.date_field :start_date, value: params[:start_date], class: "mt-1 standard-input", data: {action: "change->search#submit"} %>
      </div>
      <div class="col-span-6 md:col-span-3">
        <% min = params[:min_enjoyment].presence || 0 %>
        <% max = params[:max_enjoyment].presence || 100 %>
        <div data-controller="dual-range">
          <div class="standard-label flex justify-between">
            <%= f.label :min_enjoyment, "Enjoyment" %>
            <span class="font-normal lining-nums">
              <output data-dual-range-target="minValue"><%= min %></output>–<output data-dual-range-target="maxValue"><%= max %></output>
            </span>
          </div>
          <div class="enjoyment-range mt-1">
            <%= f.range_field :min_enjoyment, in: 0..100, value: min, class: "enjoyment-range-input", title: "Minimum enjoyment", data: {action: "input->dual-range#update input->search#submit", dual_range_target: "min"} %>
            <%= f.range_field :max_enjoyment, in: 0..100, value: max, class: "enjoyment-range-input", title: "Maximum enjoyment", data: {action: "input->dual-range#update input->search#submit", dual_range_target: "max"} %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
  <% filter_labels = [@coffee_bag&.display_name, *@tag_slugs].compact %>
  <% if filter_labels.any? %>
    <p class="mt-2 text-sm text-neutral-500">Filtered by <%= filter_labels.to_sentence %>. <%= link_to "Clear filters", shots_path, class: "standard-link" %></p>
  <% end %>
</div>
