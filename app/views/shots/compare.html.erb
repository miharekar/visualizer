<% tasting_series = [
  tasting_assessment_series(@shot, name: "Base"),
  tasting_assessment_series(@comparison, name: "Comparison")
].compact %>
<div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row">
    <div class="flex-1">
      <div class="mb-2 text-sm font-medium tracking-wide text-neutral-500 uppercase dark:text-neutral-400">Base</div>
      <%= render "details", shot: @shot, name: true %>
    </div>
    <div class="mt-6 flex-1 md:mt-0 md:ml-3">
      <div class="mb-2 text-sm font-medium tracking-wide text-neutral-500 uppercase dark:text-neutral-400">Comparison</div>
      <%= render "details", shot: @comparison, name: true %>
    </div>
  </div>
</div>
<% if tasting_series.any? %>
  <%= render "tasting_assessment", categories: tasting_assessment_categories, series: tasting_series, show_legend: true %>
<% end %>
<% if @chart %>
  <div data-controller="shot-charts"
       data-shot-charts-shot-data-value="<%= (@chart.shot_chart || []).to_json %>"
       data-shot-charts-shot-stages-value="[]"
       data-shot-charts-temperature-data-value="<%= (@chart.temperature_chart || []).to_json %>"
       data-shot-charts-comparison-data-value="<%= (@chart.comparison_data || {}).to_json %>">
    <% if Current.user&.premium? %>
      <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <div class="text-center text-lg text-neutral-900 dark:text-neutral-100">
          Adjust comparison timing
        </div>
        <div class="flex">
          <div class="mt-2 mr-2 flex grow flex-col">
            <input id="compare-range" class="shot-range flex-1 pt-2 dark:bg-neutral-900" type="range" min="-<%= @chart.duration %>" max="<%= @chart.duration %>" value="0" step="<%= @chart.timestep %>" autocomplete="off" data-shot-charts-target="compareRange" data-action="input->shot-charts#onCompareInput">
            <div class="flex pt-2">
              <div class="text-neutral-600 dark:text-neutral-400">
                -<%= ActiveSupport::Duration.build(@chart.duration / 1000).inspect %>
              </div>
              <div class="grow"></div>
              <div class="text-neutral-600 dark:text-neutral-400">
                <%= ActiveSupport::Duration.build(@chart.duration / 1000).inspect %>
              </div>
            </div>
          </div>
          <button id="compare-range-reset" class="items-center rounded-md border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-700 shadow-sm hover:bg-neutral-50 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-900" data-shot-charts-target="compareReset" data-action="click->shot-charts#onCompareReset">Reset</button>
        </div>
      </div>
    <% end %>
    <div class="mx-auto max-w-7xl sm:px-6 lg:px-8">
      <div id="shot-chart" data-shot-charts-target="shotChart"></div>
    </div>
    <% if @chart.temperature_chart.present? %>
      <div class="mx-auto max-w-7xl pb-8 sm:px-6 lg:px-8">
        <div id="temperature-chart" data-shot-charts-target="temperatureChart"></div>
      </div>
    <% end %>
  </div>
<% end %>
