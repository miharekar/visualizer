<div class="relative isolate overflow-hidden bg-linear-to-r from-indigo-950 via-rose-700 to-amber-300 py-3 text-white shadow-2xl">
  <div class="absolute top-1/2 -left-16 h-48 w-48 -translate-y-1/2 rounded-full bg-amber-200/30 blur-3xl dark:bg-amber-800/30"></div>
  <div class="absolute top-1/2 -right-10 h-48 w-48 -translate-y-1/2 rounded-full bg-sky-200/30 blur-3xl"></div>
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="relative flex flex-col gap-3 text-center sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p class="text-sm leading-6">
        <%= link_to personal_yearly_brew_path(year: 2025), class: "inline-flex items-center gap-2" do %>
          <span class="font-semibold">Daily Grind 2025</span>
          <span class="text-white/80">·</span>
          <span class="text-white/90">Your Year in Coffee is here!</span>
        <% end %>
      </p>
      <%= link_to personal_yearly_brew_path(year: 2025), class: "inline-flex w-full items-center justify-center gap-2 rounded-full bg-white/10 px-3 py-2 text-sm font-semibold text-white backdrop-blur border border-white/30 hover:bg-white/25 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto" do %>
        View stats
        <span>→</span>
      <% end %>
    </div>
  </div>
</div>
