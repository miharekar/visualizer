<%= tag.article id: dom_id(update) do %>
  <a href="<%= update_path(update.slug.presence || update.id) %>">
    <h2 class="mb-6 text-center font-serif text-4xl font-bold tracking-tight text-balance text-neutral-900 sm:mb-8 sm:text-5xl dark:text-neutral-100">
      <%= update.title %>
    </h2>
  </a>
  <div class="mx-auto max-w-prose">
    <div class="mb-2 flex justify-between text-xs">
      <time datetime="<%= update.published_at.iso8601 %>" class="flex text-neutral-400">
        <span class="h-4 w-0.5 rounded-full bg-neutral-200 dark:bg-neutral-500"></span>
        <span class="ml-2"><%= update.published_at.strftime('%B %-d, %Y') %></span>
      </time>
      <%= link_to "Edit", edit_update_path(update) if Current.user&.admin %>
    </div>
    <%= update.body %>
  </div>
<% end %>
<hr class="mx-auto w-48 text-neutral-200 last:hidden dark:text-neutral-700">
