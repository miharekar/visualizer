<tr id="journal-shot-<%= shot.id %>" data-journal-target="row" data-shot-id="<%= shot.id %>" data-version="<%= shot.updated_at.utc.iso8601(6) %>" data-manual="<%= shot.manual? if shot.has_attribute?(:has_information) %>" data-coffee-bag-id="<%= shot.coffee_bag_id %>" data-canonical-coffee-bag-id="<%= shot.canonical_coffee_bag_id %>" data-journal-partial="<%= local_assigns[:partial_update] == true %>" class="border-b border-neutral-200 dark:border-neutral-700">
  <td class="sticky left-0 z-10 bg-white px-3 py-1 dark:bg-neutral-900">
    <input type="checkbox" name="selected_shots[]" value="<%= shot.id %>" aria-label="Select shot from <%= shot.start_time %>" data-action="journal#select" class="standard-checkbox size-4" data-selection>
  </td>
  <% columns.each do |field| %>
    <% unless visible_columns.include?(field) %>
      <td id="<%= journal_cell_id(shot, field) %>" data-column="<%= field %>" data-unloaded="true" class="hidden"></td>
      <% next %>
    <% end %>
    <% editable = Current.journal.editable_columns.key?(field) && (field != "duration" || shot.manual?) %>
    <td id="<%= journal_cell_id(shot, field) %>" data-column="<%= field %>" data-value="<%= Current.journal.value(shot, field) %>" class="max-w-64 p-1 <%= 'text-center' if field == 'espresso_enjoyment' %> <%= 'hidden' unless visible_columns.include?(field) %>">
      <% if field == "actions" %>
        <div class="flex items-center gap-1 text-neutral-500 dark:text-neutral-300">
          <%= link_to shot_path(shot), class: "rounded p-1 hover:bg-neutral-100 dark:hover:bg-neutral-800", title: "View shot", aria: {label: "View shot"} do %>
            <%= inline_svg_tag "eye.svg", class: "size-4" %>
          <% end %>
          <%= link_to edit_shot_path(shot), class: "rounded p-1 hover:bg-neutral-100 dark:hover:bg-neutral-800", title: "Edit shot", aria: {label: "Edit shot"} do %>
            <%= inline_svg_tag "pencil.svg", class: "size-4" %>
          <% end %>
          <button type="button" class="rounded p-1 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950" title="Delete shot" aria-label="Delete shot" data-action="click->modal#confirm click->journal#deleteShot" data-title="Delete Shot" data-text="Are you sure you want to permanently delete this shot from <%= shot.start_time.in_time_zone(Current.timezone).to_formatted_s(:long) %>?" data-delete-url="<%= shot_path(shot) %>">
            <%= inline_svg_tag "trash.svg", class: "size-4" %>
          </button>
        </div>
      <% elsif field == "image" %>
        <% if shot.image.attached? && shot.image.variable? %>
          <%= image_tag shot.image.variant(:thumb), class: "h-8 w-10 rounded object-cover", alt: "Shot photo", loading: "lazy" %>
        <% end %>
      <% elsif field == "start_time" %>
        <span class="block whitespace-nowrap px-2 py-1"><%= journal_display(Current.journal, shot, field) %></span>
        <% if local_assigns[:pinned] %><span class="block px-2 text-xs text-neutral-500"><%= local_assigns[:matches] ? "New · pinned until next search" : "New · outside current search" %></span><% end %>
      <% elsif editable && (field == "coffee" || field == "tag_list" || Journal::NOTES.include?(field) || Journal::DROPDOWN_FIELDS.include?(field)) %>
        <button type="button" class="focus:ring-terracotta-500 w-full rounded px-2 py-1 text-left hover:bg-neutral-100 focus:ring-2 dark:hover:bg-neutral-800" data-action="journal#edit" aria-label="Edit <%= Current.journal.columns[field] %>" data-display>
          <span class="block truncate"><%= journal_display(Current.journal, shot, field).presence || "—" %></span>
        </button>
      <% elsif field == "espresso_enjoyment" %>
        <div class="flex justify-center" data-controller="range">
          <%= number_field_tag "shots[#{shot.id}][espresso_enjoyment]", shot.espresso_enjoyment, min: 0, max: 100, step: 1, inputmode: "numeric", placeholder: "—", aria: {label: "Enjoyment"}, style: ("background-color: #{enjoyment_hex(shot.espresso_enjoyment)};" if shot.espresso_enjoyment.present?), class: "h-6 w-9! rounded border-none bg-neutral-100 px-0! py-0! text-center! text-white [appearance:textfield] focus:ring-2 focus:ring-terracotta-500 dark:bg-neutral-800 [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none", data: {editor: true, range_target: "color", action: "focus->journal#focus input->range#update blur->journal#commit keydown->journal#key"} %>
        </div>
      <% elsif editable %>
        <% display_value = journal_display(Current.journal, shot, field) %>
        <input type="<%= journal_input_type(field) %>" name="shots[<%= shot.id %>][<%= field %>]" value="<%= display_value %>" aria-label="<%= Current.journal.columns[field] %>" placeholder="—" step="<%= field == 'duration' ? 'any' : '1' %>" style="width: <%= [display_value.length, 1].max + 3 %>ch" class="focus:border-terracotta-500 focus:ring-terracotta-500 max-w-64 min-w-0 rounded border border-transparent bg-transparent px-2 py-1 text-inherit shadow-none hover:border-neutral-200 focus:bg-white focus:ring-1 focus:outline-none dark:hover:border-neutral-700 dark:focus:bg-neutral-800" data-editor data-action="focus->journal#focus input->journal#resizeInput blur->journal#commit keydown->journal#key">
      <% else %>
        <span class="block px-2 py-1"><%= journal_display(Current.journal, shot, field).presence || "—" %></span>
      <% end %>
    </td>
  <% end %>
</tr>
