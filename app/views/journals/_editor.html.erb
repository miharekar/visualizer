<%= turbo_frame_tag "journal-editor" do %>
  <% if shots.blank? && local_assigns[:error].present? %>
    <p class="mb-4 text-sm text-red-600 dark:text-red-400"><%= error %></p>
  <% end %>
  <% if shots.present? %>
    <div class="border-terracotta-300 mb-4 rounded border p-4">
      <h2 class="mb-3 text-lg font-semibold"><%= Current.journal.columns[field] %> / <%= pluralize(shots.size, "shot") %></h2>
      <%= form_with url: journal_path, method: :patch, class: "space-y-4", data: {turbo_stream: true} do |f| %>
        <% shots.each do |shot| %><%= hidden_field_tag "ids[]", shot.id, id: nil %><% end %>
        <%= f.hidden_field :field, value: field %>
        <%= f.hidden_field :editor, value: "true" %>
        <% if local_assigns[:error].present? %>
          <p class="text-sm text-red-600 dark:text-red-400"><%= error %></p>
        <% end %>
        <% if field == "coffee" %>
          <%= render "journals/coffee_fields", attributes: attributes || {} %>
        <% elsif Journal::NOTES.include?(field) %>
          <%= f.label :value, Current.journal.columns[field], for: "journal-editor-value", class: "standard-label" %>
          <%= rich_text_area_tag :value, value, id: "journal-editor-value" %>
        <% elsif field == "tag_list" %>
          <div data-controller="tags" data-tags-user-tags-value="<%= Current.user.tags.pluck(:name).to_json %>">
            <%= f.label :value, "Tags", for: "journal-editor-value", class: "standard-label" %>
            <%= f.text_field :value, value: value, id: "journal-editor-value", class: "standard-input mt-1", data: {tags_target: "input"} %>
          </div>
        <% elsif Journal::DROPDOWN_FIELDS.include?(field) %>
          <%= f.label :value, Current.journal.columns[field], for: "journal-editor-value", class: "standard-label" %>
          <%= render "shared/combobox", input_name: "value", input_id: "journal-editor-value", hidden_input_name: "_value", selected: value, collection: Current.journal.dropdown_values(field), name_method: :itself, id_method: :itself, allow_custom: true %>
        <% else %>
          <%= f.label :value, Current.journal.columns[field], for: "journal-editor-value", class: "standard-label" %>
          <%= f.text_field :value, type: journal_input_type(field), value: value, id: "journal-editor-value", step: field == "duration" ? "any" : "1", class: "standard-input mt-1" %>
        <% end %>
        <div class="flex gap-3">
          <%= f.submit shots.one? ? "Save" : "Apply to #{shots.size} shots", class: "button-terracotta px-4 py-2" %>
          <%= link_to "Cancel", edit_journal_path, class: "button-white px-4 py-2", data: {turbo_frame: "journal-editor"} %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
