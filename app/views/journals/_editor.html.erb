<%= turbo_frame_tag "journal-editor" do %>
  <dialog data-controller="journal-dialog" data-action="close->journal-dialog#remove cancel->journal-dialog#cancel" closedby="closerequest" class="m-auto max-h-[90dvh] w-[calc(100%-2rem)] max-w-xl rounded-lg bg-white p-6 text-neutral-900 shadow-xl backdrop:bg-black/40 dark:bg-neutral-900 dark:text-neutral-100 <%= field == 'tag_list' || Journal::NOTES.include?(field) ? 'overflow-y-auto' : 'overflow-visible' %>">
    <% if shots.blank? %>
      <p class="text-sm text-red-600 dark:text-red-400"><%= error %></p>
      <div class="mt-4 flex justify-end"><button type="button" class="button-white px-4 py-2" data-action="journal-dialog#close">Cancel</button></div>
    <% else %>
      <%= form_with url: journal_path, method: :patch, data: {action: "turbo:submit-start->journal-dialog#start turbo:submit-end->journal-dialog#complete"} do |f| %>
        <fieldset class="space-y-4" data-journal-dialog-target="fields">
          <% shots.each do |shot| %><%= hidden_field_tag "ids[]", shot.id, id: nil %><% end %>
          <%= f.hidden_field :field, value: field %>
          <%= f.hidden_field :editor, value: "true" %>
          <% if local_assigns[:error].present? %>
            <p class="text-sm text-red-600 dark:text-red-400"><%= error %></p>
          <% end %>
          <% if field == "coffee" %>
            <% coffee_bags = Current.user.coffee_bags.selectable_for(shots).to_a %>
            <%= label_tag "journal-coffee-bag", "Coffee bag", class: "standard-label" %>
            <%= render "shared/combobox", input_name: "_coffee_bag", input_id: "journal-coffee-bag", hidden_input_name: "value", selected: coffee_bags.find { it.id == value }, collection: coffee_bags, name_method: :full_display_name, preserve_order: true %>
          <% elsif Journal::NOTES.include?(field) %>
            <%= f.label :value, journal.columns[field], for: "journal-editor-value", class: "standard-label" %>
            <%= rich_text_area_tag :value, value, id: "journal-editor-value", class: "mt-2" %>
          <% elsif field == "tag_list" %>
            <div data-controller="tags" data-tags-user-tags-value="<%= Current.user.tags.pluck(:name).to_json %>">
              <%= f.label :value, "Tags", for: "journal-editor-value", class: "standard-label" %>
              <%= f.text_field :value, value: value, id: "journal-editor-value", class: "standard-input mt-1", data: {tags_target: "input"} %>
            </div>
          <% elsif Journal::DROPDOWN_FIELDS.include?(field) %>
            <%= f.label :value, journal.columns[field], for: "journal-editor-value", class: "standard-label" %>
            <%= render "shared/combobox", input_name: "value", input_id: "journal-editor-value", hidden_input_name: "_value", selected: value, collection: journal.dropdown_values(field), name_method: :itself, id_method: :itself, allow_custom: true %>
          <% else %>
            <%= f.label :value, journal.columns[field], for: "journal-editor-value", class: "standard-label" %>
            <%= f.text_field :value, **journal_input_options(field), value: value, id: "journal-editor-value", class: "standard-input mt-1" %>
          <% end %>
          <p class="text-sm text-red-600 empty:hidden dark:text-red-400" data-journal-dialog-target="error"></p>
          <div class="flex justify-end gap-3">
            <button type="button" class="button-white px-4 py-2" data-action="journal-dialog#close" autofocus>Cancel</button>
            <%= f.submit shots.one? ? "Save" : "Apply to #{shots.size} shots", class: "button-terracotta px-4 py-2" %>
          </div>
        </fieldset>
      <% end %>
    <% end %>
  </dialog>
<% end %>
