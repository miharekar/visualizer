<% content_for(:html_title) { "Visualizer | Your Shots" } %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>
<div class="flex w-full min-w-0 flex-col text-neutral-900 dark:text-neutral-100" data-controller="journal panel upload-drop" data-upload-drop-upload-outlet="#shot-upload-form" data-journal-url-value="<%= journal_path %>" data-journal-create-url-value="<%= shots_path %>" data-journal-columns-url-value="<%= profile_journal_columns_path %>" data-journal-timezone-value="<%= Current.timezone.tzinfo.name %>" data-action="turbo:before-visit@document->journal#beforeVisit beforeunload@window->journal#beforeUnload submit->journal#beforeSubmit turbo:before-stream-render@document->journal#beforeStream">
  <div data-upload-drop-target="overlay" class="bg-oxford-blue-500/50 fixed inset-0 z-99 hidden items-center justify-center backdrop-blur-sm">
    <div class="text-center">
      <h3 class="mb-2 text-2xl font-medium text-white">Drop anywhere to upload</h3>
      <p class="text-white/90">Release your files to start the upload</p>
    </div>
  </div>
  <div class="mx-auto w-full max-w-7xl sm:px-6 lg:px-8">
    <%= render "shots/index_header" %>
    <%= render "shots/upload_form", show_form: false %>
    <div id="journal-columns-panel" class="mx-4 mt-4 hidden sm:mx-0" data-journal-target="columnsPanel">
      <div class="flex flex-wrap gap-2" data-journal-target="columnList" data-action="pointermove->journal#dragColumn pointerup->journal#finishColumnDrag pointercancel->journal#cancelColumnDrag keydown.esc@window->journal#cancelColumnDrag">
        <% @columns.each do |field| %>
          <div data-column-choice="<%= field %>" class="flex items-center gap-2 rounded border border-neutral-200 p-2 dark:border-neutral-700">
            <button type="button" class="touch-none cursor-grab rounded p-1 text-neutral-500 active:cursor-grabbing focus-visible:ring-2 focus-visible:ring-terracotta-500" data-action="pointerdown->journal#startColumnDrag keydown->journal#moveColumn" aria-label="Reorder <%= @journal.columns[field] %>">
              <svg viewBox="0 0 16 16" fill="currentColor" class="size-4" aria-hidden="true"><circle cx="5" cy="3" r="1.5" /><circle cx="11" cy="3" r="1.5" /><circle cx="5" cy="8" r="1.5" /><circle cx="11" cy="8" r="1.5" /><circle cx="5" cy="13" r="1.5" /><circle cx="11" cy="13" r="1.5" /></svg>
            </button>
            <label class="flex items-center gap-2"><%= check_box_tag "visible_columns[]", field, @visible_columns.include?(field), id: nil, data: {action: "journal#columns"}, class: "standard-checkbox size-4" %><%= @journal.columns[field] %></label>
          </div>
        <% end %>
      </div>
      <div class="mt-3 flex justify-end"><button type="button" class="button-white px-3 py-2" data-action="journal#resetColumns">Reset</button></div>
    </div>
  </div>
  <div class="mt-4 w-full min-w-0 px-4 sm:px-6 lg:px-8">
    <% unless Current.user.premium? %>
      <p class="mb-4 text-sm text-neutral-500">Showing shots uploaded in the last month. <%= link_to "Premium", premium_index_path, class: "standard-link" %> includes older history.</p>
    <% end %>
    <%= form_with url: shots_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3", data: { turbo_stream: true, journal_target: "search", action: ("input->journal#search change->journal#search" if Current.user.premium?) } do |f| %>
      <%= f.hidden_field :fresh_search, value: "1" %>
      <label class="standard-label min-w-48 flex-1">Search<%= f.search_field :q, value: params[:q], class: "standard-input mt-1", placeholder: "Coffee, profile, notes…" %></label>
      <label class="standard-label">Brew date<%= f.date_field :start_date, value: params[:start_date], class: "standard-input mt-1" %></label>
      <% if Current.user.coffee_management_enabled? %>
        <label class="standard-label">Coffee<%= f.select :coffee_bag, @coffee_bags.map { [it.full_display_name, it.id] }, {include_blank: "All coffees", selected: params[:coffee_bag]}, class: "standard-input mt-1 max-w-64" %></label>
      <% end %>
      <% if Current.user.premium? %>
        <label class="standard-label">Tags<%= f.text_field :tags, value: params[:tags], class: "standard-input mt-1", placeholder: "Comma-separated tags" %></label>
      <% end %>
      <%= f.submit "Search", class: "button-white px-4 py-2" unless Current.user.premium? %>
    <% end %>
    <div class="fixed inset-x-4 top-20 z-30 mx-auto hidden w-fit max-w-full flex-wrap items-center justify-center gap-3 rounded-lg bg-white/95 px-4 py-3 shadow-lg ring-1 ring-neutral-200 backdrop-blur dark:bg-neutral-800/95 dark:ring-neutral-700" data-journal-target="bulkBar">
      <span data-journal-target="selection">0 selected</span>
      <button type="button" class="standard-link" data-action="journal#bulkCoffee">Assign coffee</button>
      <button type="button" class="standard-link" data-action="journal#bulkField">Set field</button>
      <% if Current.user.premium? %><button type="button" class="standard-link" data-action="journal#bulkTags">Add/remove tags</button><% end %>
      <button type="button" class="standard-link" data-action="journal#compare">Compare</button>
    </div>
    <div class="mb-3 hidden flex-wrap items-center gap-3 text-sm" data-journal-target="saveBar">
      <button type="button" class="standard-link hidden" data-journal-target="undo" data-action="journal#undo">Undo last change</button>
      <span role="status" aria-live="polite" data-journal-target="status" class="text-sm"></span>
      <button type="button" class="standard-link hidden" data-journal-target="retry" data-action="journal#retry">Retry</button>
      <button type="button" class="standard-link hidden" data-journal-target="reload" data-action="journal#reload">Reload saved values</button>
    </div>
    <div class="border-terracotta-300 mb-4 hidden rounded border p-4" data-journal-target="draft">
      <form data-journal-target="draftForm" data-action="submit->journal#create" class="grid gap-3 sm:grid-cols-3">
        <div class="space-y-3"><%= render "journals/coffee_fields" %></div>
        <div class="space-y-3">
          <label class="standard-label">Brewed<%= datetime_local_field_tag :start_time, Time.current.strftime("%Y-%m-%dT%H:%M:%S"), required: true, step: 1, class: "standard-input mt-1", data: {shot_field: true} %></label>
          <% %w[profile_title bean_weight drink_weight duration grinder_setting espresso_enjoyment].each do |field| %>
            <label class="standard-label"><%= @journal.columns[field] %><input name="<%= field %>" type="<%= journal_input_type(field) %>" step="any" data-shot-field class="standard-input mt-1"></label>
          <% end %>
        </div>
        <div><label for="draft_notes" class="standard-label">Notes</label><%= rich_text_area_tag :espresso_notes, nil, id: "draft_notes", data: {shot_field: true} %></div>
        <div class="flex justify-end gap-3 sm:col-span-3"><button type="button" class="button-white px-4 py-2" data-action="journal#cancelDraft">Cancel</button><button class="button-terracotta px-4 py-2">Add shot</button></div>
      </form>
    </div>
    <div class="overflow-x-auto rounded border border-neutral-200 dark:border-neutral-700">
      <table class="w-max min-w-full text-sm" data-journal-target="table">
        <caption class="sr-only">Coffee journal. Select rows for bulk edits, or activate a cell to edit it.</caption>
        <thead class="bg-neutral-50 dark:bg-neutral-800">
          <tr>
            <th class="sticky left-0 z-10 bg-neutral-50 p-3 dark:bg-neutral-800"><input type="checkbox" aria-label="Select all loaded shots" data-action="journal#selectAll" class="standard-checkbox size-4"></th>
            <% @columns.each do |field| %>
              <th scope="col" data-column="<%= field %>" class="px-3 py-3 whitespace-nowrap <%= field == 'espresso_enjoyment' ? 'text-center' : 'text-left' %> <%= 'hidden' unless @visible_columns.include?(field) %>"><%= @journal.columns[field] %></th>
            <% end %>
          </tr>
        </thead>
        <tbody id="journal-rows" data-journal-target="rows"><%= render partial: "journals/row", collection: @shots, as: :shot, locals: {columns: @columns, visible_columns: @visible_columns} %></tbody>
      </table>
    </div>
    <p id="journal-empty" class="my-6 text-center text-neutral-500 empty:hidden"><%= "No matching shots." if @shots_count.zero? %></p>
    <%= render "shared/cursor_loader", cursor: @cursor, path: shots_path(params.slice(:q, :start_date, :coffee_bag, :tags).permit(:q, :start_date, :coffee_bag, :tags).merge(before: @cursor, format: :turbo_stream)) %>
    <dialog data-journal-target="dialog" data-action="cancel->journal#closeDialog" class="m-auto max-h-[90vh] w-full max-w-xl overflow-y-auto rounded-lg bg-white p-6 text-neutral-900 shadow-xl backdrop:bg-black/40 dark:bg-neutral-900 dark:text-neutral-100">
      <div class="mb-4 flex items-center justify-between">
        <h2 data-journal-target="dialogTitle" class="font-serif text-2xl"></h2>
        <button type="button" class="button-white px-3 py-2" data-action="journal#closeDialog">Cancel</button></div>
      <form data-journal-target="dialogForm" data-action="submit->journal#saveDialog" class="space-y-4">
        <div data-journal-target="coffeeFields" class="space-y-3"><%= render "journals/coffee_fields" %></div>
        <div data-journal-target="fieldFields" class="space-y-3">
          <label class="standard-label">Field<select name="field" class="standard-input mt-1"><% @journal.columns.except("coffee", *Journal::NOTES).each do |field, label| %><option value="<%= field %>"><%= label %><%= " (manual shots only)" if %w[start_time duration].include?(field) %></option><% end %></select></label>
          <label class="standard-label">Value<input name="value" class="standard-input mt-1"></label>
        </div>
        <div data-journal-target="tagFields" class="space-y-3"><label class="standard-label">Action<select name="tag_action" class="standard-input"><option value="add">Add tags</option><option value="remove">Remove tags</option></select></label><label class="standard-label">Tags<input name="tags" class="standard-input" placeholder="Comma-separated tags"></label></div>
        <div data-journal-target="noteFields"><label for="journal_note" class="standard-label">Notes · Escape discards changes</label><%= rich_text_area_tag :note, nil, id: "journal_note" %></div>
        <button data-journal-target="apply" class="button-terracotta px-4 py-2">Apply to selected shots</button>
      </form>
    </dialog>
  </div>
</div>
