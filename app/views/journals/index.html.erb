<% content_for(:html_title) { "Visualizer | Your Shots" } %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>
<div class="flex w-full min-w-0 flex-col text-neutral-900 dark:text-neutral-100" data-controller="journal-columns journal-navigation panel upload-drop modal" data-upload-drop-upload-outlet="#shot-upload-form">
  <%= render "shared/modal" %>
  <div data-upload-drop-target="overlay" class="bg-oxford-blue-500/50 fixed inset-0 z-99 hidden items-center justify-center backdrop-blur-sm">
    <div class="text-center">
      <h3 class="mb-2 text-2xl font-medium text-white">Drop anywhere to upload</h3>
      <p class="text-white/90">Release your files to start the upload</p>
    </div>
  </div>
  <div class="mx-auto w-full max-w-7xl sm:px-6 lg:px-8">
    <%= render "shots/index_header" %>
    <%= render "shots/upload_form", show_form: false %>
    <%= render "journals/columns" %>
  </div>
  <div class="mt-4 w-full min-w-0 px-4 pb-6 sm:px-6 lg:px-8">
    <% unless Current.user.premium? %>
      <p class="mb-4 text-sm text-neutral-500">Showing shots uploaded in the last month. <%= link_to "Premium", premium_index_path, class: "standard-link" %> includes older history.</p>
    <% end %>
    <%= form_with url: shots_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3", data: { turbo_frame: "journal-results", controller: "search", search_target: "form", journal_navigation_target: "search", action: "submit->journal-navigation#search turbo:submit-end->journal-navigation#complete #{'input->search#submit' if Current.user.premium?}" } do |f| %>
      <% %w[coffee_bag tags].each do |filter| %>
        <%= f.hidden_field filter, value: params[filter] if params[filter].present? %>
      <% end %>
      <label class="standard-label min-w-48 flex-1">Search<%= f.search_field :q, value: params[:q], class: "standard-input mt-1", placeholder: "Coffee, notes, tags..." %></label>
      <%= f.submit "Search", class: "button-white px-4 py-2" unless Current.user.premium? %>
    <% end %>
    <%= turbo_frame_tag "journal-editor" %>
    <%= turbo_frame_tag "journal-results", data: {controller: "journal-selection", turbo_action: "advance", journal_navigation_target: "results", action: "turbo:frame-load->journal-navigation#loaded"} do %>
      <%= turbo_stream.update "journal-count" do %><span id="journal-count-<%= @journal_search_id %>"><%= @shots_count.zero? ? "No Shots" : pluralize(@shots_count, "Shot") %></span><% end %>
      <%= render "journals/toolbar" %>
      <div class="relative max-h-[70dvh] min-h-64 overflow-auto rounded border border-neutral-200 dark:border-neutral-700">
        <table class="w-max min-w-full text-sm" data-turbo-prefetch="false">
          <caption class="sr-only">Coffee journal. Select rows for bulk edits, or activate a cell to edit it.</caption>
          <thead class="sticky top-0 z-20 bg-neutral-50 dark:bg-neutral-800">
            <tr>
              <th class="sticky left-0 z-10 bg-neutral-50 p-3 dark:bg-neutral-800">
                <label><span class="sr-only">Select up to 100 loaded shots</span><input type="checkbox" data-journal-selection-target="all" data-action="journal-selection#selectAll" class="standard-checkbox size-4"></label>
              </th>
              <% @visible_columns.each do |field| %>
                <th scope="col" class="px-3 py-3 whitespace-nowrap <%= field == 'espresso_enjoyment' ? 'text-center' : 'text-left' %>"><%= journal.columns[field] %></th>
              <% end %>
            </tr>
          </thead>
          <tbody id="journal-rows-<%= @journal_search_id %>"><%= render partial: "journals/row", collection: @shots, as: :shot, locals: {visible_columns: @visible_columns} %></tbody>
        </table>
        <p id="journal-empty-<%= @journal_search_id %>" class="my-6 text-center text-neutral-500 empty:hidden"><%= "No matching shots." if @shots_count.zero? %></p>
        <%= render "journals/cursor" %>
      </div>
    <% end %>
  </div>
</div>
