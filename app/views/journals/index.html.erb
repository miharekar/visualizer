<% content_for(:html_title) { "Visualizer | Your Shots" } %>
<% content_for(:contained_layout) { "true" } %>
<% content_for(:head) { tag.meta(name: "turbo-cache-control", content: "no-cache") } %>
<div class="flex min-h-0 w-full min-w-0 flex-1 flex-col text-neutral-900 dark:text-neutral-100" data-controller="journal-columns journal-navigation panel upload-drop modal" data-upload-drop-upload-outlet="#shot-upload-form">
  <%= render "shared/modal" %>
  <%= render "shots/upload_overlay" %>
  <div class="mx-auto w-full max-w-7xl shrink-0 sm:px-6 lg:px-8">
    <%= render "shots/index_header" %>
    <%= render "shots/upload_form", show_form: false %>
    <%= render "journals/columns" %>
  </div>
  <div class="mt-4 flex min-h-0 w-full min-w-0 flex-1 flex-col px-4 pb-6 sm:px-6 lg:px-8">
    <% unless Current.user.premium? %>
      <p class="mb-4 text-sm text-neutral-500">Showing shots uploaded in the last month. <%= link_to "Premium", premium_index_path, class: "standard-link" %> includes older history.</p>
    <% end %>
    <%= form_with url: shots_path, method: :get, class: "mb-4 flex flex-wrap items-end gap-3", data: { turbo_frame: "journal-results", controller: "search", search_target: "form", journal_navigation_target: "search", action: "submit->journal-navigation#search turbo:submit-end->journal-navigation#complete #{'input->search#submit' if Current.user.premium?}" } do |f| %>
      <% %w[coffee_bag tags].each do |filter| %>
        <%= f.hidden_field filter, value: params[filter] if params[filter].present? %>
      <% end %>
      <label class="standard-label min-w-48 flex-1">Search<%= f.search_field :q, value: params[:q], class: "standard-input mt-1", placeholder: "Coffee, notes, tags..." %></label>
      <%= f.submit "Search", class: "button-white px-4 py-2" unless Current.user.premium? %>
    <% end %>
    <% filter_labels = journal.filter_labels(params) %>
    <% if filter_labels.any? %>
      <p class="-mt-2 mb-4 text-sm text-neutral-500">Filtered by <%= filter_labels.to_sentence %>. <%= link_to "Clear filters", shots_path(q: params[:q].presence), class: "standard-link" %></p>
    <% end %>
    <%= turbo_frame_tag "journal-editor" %>
    <%= turbo_frame_tag "journal-results", class: "flex min-h-0 flex-1 flex-col", data: {controller: "journal-selection", turbo_action: "advance", journal_navigation_target: "results", action: "turbo:frame-load->journal-navigation#loaded"} do %>
      <%= turbo_stream.update "shots-count", @shots_count.zero? ? "No Shots" : pluralize(@shots_count, "Shot") %>
      <%= render "journals/toolbar" %>
      <div class="relative min-h-0 flex-1 overflow-auto rounded border border-neutral-200 dark:border-neutral-700" data-prefetch-lazy-root>
        <table class="w-max text-sm" data-turbo-prefetch="false">
          <thead class="sticky top-0 z-20 bg-neutral-50 dark:bg-neutral-800">
            <tr>
              <th class="sticky left-0 z-10 bg-neutral-50 p-3 dark:bg-neutral-800">
                <input type="checkbox" title="Select up to 100 loaded shots" data-journal-selection-target="all" data-action="journal-selection#selectAll" class="standard-checkbox size-4">
              </th>
              <% journal.visible_columns.each do |field| %>
                <th class="px-3 py-3 whitespace-nowrap <%= field == 'espresso_enjoyment' ? 'text-center' : 'text-left' %>"><%= journal.columns[field] %></th>
              <% end %>
            </tr>
          </thead>
          <tbody id="journal-rows-<%= @journal_search_id %>"><%= render partial: "journals/row", collection: @shots, as: :shot %></tbody>
        </table>
        <p class="my-6 text-center text-neutral-500 empty:hidden"><%= "No matching shots." if @shots_count.zero? %></p>
        <%= render "journals/cursor" %>
      </div>
    <% end %>
  </div>
</div>
