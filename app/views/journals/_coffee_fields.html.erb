<% if Current.user.coffee_management_enabled? %>
  <label class="standard-label">Coffee bag
    <select name="coffee_bag_id" data-shot-field class="standard-input mt-1">
      <option value="">No bag</option>
      <% @coffee_bags.each do |bag| %>
        <option value="<%= bag.id %>"><%= bag.full_display_name %></option>
      <% end %>
    </select>
  </label>
<% else %>
  <div data-controller="autocomplete" data-autocomplete-url-value="<%= autocomplete_coffee_bags_canonical_index_path %>" data-autocomplete-min-length-value="<%= CanonicalCoffeeBag::MIN_TERM_LENGTH %>" role="combobox">
    <label class="standard-label">Search coffee database
      <input type="search" class="standard-input mt-1" data-autocomplete-target="input" placeholder="Roaster or coffee name">
    </label>
    <input type="hidden" name="canonical_coffee_bag_id" data-shot-field data-autocomplete-target="hidden">
    <ul data-autocomplete-target="results" class="max-h-48 overflow-auto"></ul>
  </div>
  <p class="text-sm text-neutral-500">Or enter coffee details manually. Clear search selection to use manual details.</p>
  <label class="standard-label">Roaster<input name="bean_brand" data-shot-field class="standard-input mt-1"></label>
  <label class="standard-label">Coffee name<input name="bean_type" data-shot-field class="standard-input mt-1"></label>
<% end %>
