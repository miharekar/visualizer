<% shots.each do |shot| %>
  <% fields.each do |field| %>
    <%= turbo_stream.update journal_cell_id(shot, field) do %>
      <%= render partial: "journals/cell", formats: [:html], locals: {shot: shot, field: field} %>
    <% end %>
  <% end %>
<% end %>
<% if local_assigns[:editor] %>
  <%= turbo_stream.update "journal-editor", "" %>
  <%= turbo_stream.replace "journal-selection-reset" do %>
    <span id="journal-selection-reset" class="hidden" data-journal-selection-target="reset"></span>
  <% end %>
<% end %>
