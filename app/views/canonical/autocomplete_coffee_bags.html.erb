<div class="bg-white py-1 dark:bg-neutral-900">
  <% @coffee_bags.each do |coffee_bag| %>
    <li class="px-4 py-2 text-sm" role="option" data-autocomplete-value="<%= coffee_bag.id %>" data-roaster="<%= coffee_bag.canonical_roaster.name %>" data-coffee-bag="<%= coffee_bag.name %>">
      <%= coffee_bag.name %><% if params[:require_roaster] != "true" %> (<%= coffee_bag.canonical_roaster.name %>)
      <% else %>
        <div data-coffee-bag-payload-value="<%= coffee_bag.attributes.slice(*CoffeeBag::DISPLAY_ATTRIBUTES).to_json %>"></div>
      <% end %>
    </li>
  <% end %>
</div>
