<div data-controller="notifications-container" class="pointer-events-none fixed inset-0 z-30 flex items-end px-4 py-6 sm:top-16 sm:items-start sm:p-6">
  <div id="notifications-container" class="flex w-full flex-col items-center gap-y-4 sm:items-end">
    <% flash.each do |type, message| %>
      <% if message.is_a?(Hash) %>
        <%= render "notifications/notification", notification: Notification.new(type: type, **message.symbolize_keys) %>
      <% else %>
        <%= render "notifications/notification", notification: Notification.new(type: type, heading: message) %>
      <% end %>
    <% end %>
    <% flash.clear %>
  </div>
</div>
