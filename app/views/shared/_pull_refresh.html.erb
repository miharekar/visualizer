<div class="pointer-events-none fixed inset-x-0 top-2 z-50 flex justify-center" data-controller="pull-refresh" data-action="touchstart@window->pull-refresh#touchstart touchmove@window->pull-refresh#touchmove touchend@window->pull-refresh#touchend touchcancel@window->pull-refresh#touchcancel" data-pull-refresh-threshold-value="80" data-pull-refresh-browser-value="<%= content_for?(:contained_layout) %>">
  <div class="pull-refresh-indicator min-w-40 opacity-0" data-pull-refresh-target="indicator">
    Pull to refresh
  </div>
</div>
